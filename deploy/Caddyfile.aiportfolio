# AI Portfolio
aiportfolio.beetikmx.com {
    root * /var/www/RGL-Portfolio
    encode gzip zstd
    try_files {path} /index.html
    file_server

    @freshCode path *.html *.css *.js
    header @freshCode Cache-Control "no-cache, must-revalidate"

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
    }
}
